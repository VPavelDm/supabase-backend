# Secrets for `supabase functions serve <slug> --env-file supabase/functions/.env`.
# Copy this file to .env (gitignored) and fill in the values. Debug builds of
# the apps talk to the local stack, so a route that needs a secret needs it
# here too. Only set the keys you have: the routes treat an empty value as
# set, so leave unknown ones out rather than blank.

# Lyncil / generate-lyrics
# LYNCIL_APP_KEY must equal SBConstants.appKey in the Lyncil app.
LYNCIL_APP_KEY=
# Either the app-specific key or the project-wide fallback below.
LYNCIL_OPENAI_API_KEY=
# Optional; the route has a default model.
# LYNCIL_OPENAI_MODEL=

# Lyncil / generate-song + song-status
# Which provider makes songs: mureka (default) or google (Lyria).
# LYNCIL_SONG_PROVIDER=google
# Mureka, platform.mureka.ai
LYNCIL_MUREKA_API_KEY=
# Optional; defaults to mureka-9.
# LYNCIL_MUREKA_MODEL=
# Google Lyria, aistudio.google.com (billing must be on; Lyria has no free tier)
LYNCIL_GEMINI_API_KEY=
# Optional; defaults to lyria-3.5.
# LYNCIL_LYRIA_MODEL=
# Local runs only: signed track links are built from the Docker-internal
# http://kong:8000; this swaps in an address the simulator can reach. Never
# set it on the hosted project.
LYNCIL_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Adapty secret keys (App settings -> General -> API keys -> Secret key),
# for the song allowance per plan. Production serves App Store builds,
# staging serves simulators and TestFlight; with neither set every caller
# counts as having no plan.
LYNCIL_ADAPTY_SECRET_KEY=
LYNCIL_ADAPTY_STAGING_SECRET_KEY=
# Staging builds get the stored sample (lyncil-tracks/_staging/sample.mp3)
# instead of a paid track; set to real to send them to the provider too.
# LYNCIL_STAGING_SONGS=real
# Share links (share.ts). LYNCIL_WEB_KEY is the music.lyncil.com Lambda's
# key for shared-song; any long random string locally, and the same value in
# the web page's config. LYNCIL_SHARE_BASE_URL points links at a local page.
LYNCIL_WEB_KEY=
# LYNCIL_SHARE_BASE_URL=http://localhost:4321

# Project-wide fallback OpenAI key
# OPENAI_API_KEY=
