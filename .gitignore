# Supabase CLI generated state
.branches/
.temp/

# Env files
.env
.env.*
!.env.example

# Local API keys (the App Store Connect .p8 for store-products.ts, …).
# Their contents go into Supabase secrets; the files never get committed.
secrets/

# macOS
.DS_Store

# Lyria try-out output (snippets/lyncil-try-lyria.ts)
snippets/lyria-*.mp3
snippets/lyria-*.wav
snippets/my-lyrics*.txt
# A Lyria staging sample kept for listening, not used by any code
supabase/snippets/*.mp3

# CloudFront configs generated with secrets in them (workers/treddy-mcp/cloudfront)
workers/treddy-mcp/cloudfront/*.json
