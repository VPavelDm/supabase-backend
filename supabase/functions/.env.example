# Secrets for `supabase functions serve <slug> --env-file supabase/functions/.env`.
# Copy to .env (gitignored) and fill in. Debug builds of the apps talk to the
# local stack, so a route that needs a secret needs it here too.

# Lyncil — generate-lyrics
LYNCIL_APP_KEY=            # must equal SBConstants.appKey in the Lyncil app
LYNCIL_OPENAI_API_KEY=     # or rely on OPENAI_API_KEY below
LYNCIL_OPENAI_MODEL=       # optional

# Project-wide fallback
OPENAI_API_KEY=
